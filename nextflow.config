manifest {
    name = 'watkins/pbgatk-nextflow'
    version = '0.1.0'
    description = 'Watkins Parabricks + bcftools workflow in Nextflow DSL2'
}

params {

    samplesheet = null
    ref = null
    outdir = 'results'
    contig_subset = ''
    merge_chunk_size = 250
    run_flagstat = false

    // =========================
    // OFFLINE CONTAINERS ONLY
    // =========================
    local_container_dir = null


    container_parabricks = "${local_container_dir}/parabricks-4.3.2-1.sif"
    container_bcftools   = "${local_container_dir}/bcftools-1.21.sif"
    container_samtools   = "${local_container_dir}/samtools-1.18.sif"

    // compute
    call_htvc_threads = 32
    call_default_gpus = 1

    // SLURM config
    slurm_cpu_queue = 'jic-compute,nbi-compute'
    slurm_gpu_queue = 'jic-gpu'
    slurm_gpu_type = 'a100'
    slurm_gpu_request = 1

    slurm_gpu_localscratch_gb = 1000
    slurm_merge_localscratch_gb = 1500

    // resources
    cpu_small_cpus = 4
    cpu_small_memory = '16 GB'
    cpu_small_time = '2h'

    cpu_medium_cpus = 16
    cpu_medium_memory = '64 GB'
    cpu_medium_time = '8h'

    cpu_merge_cpus = 32
    cpu_merge_memory = '500 GB'
    cpu_merge_time = '24h'

    gpu_call_cpus = 32
    gpu_call_memory = '950 GB'
    gpu_call_time = '36h'

    // Singularity cache (fixed path, no env calls allowed)
    singularity_cache_dir = "${projectDir}/.singularity"
}

process {

    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'

    // =========================
    // CONTAINERS (FORCED LOCAL)
    // =========================

    withName: PBGATK_GERMLINE {
        label = 'gpu_call'
        container = params.container_parabricks
    }

    withName: COMPRESS_AND_INDEX_VCF {
        label = 'cpu_medium'
        container = params.container_bcftools
    }

    withName: GET_CONTIGS {
        label = 'cpu_small'
        container = params.container_bcftools
    }

    withName: EXTRACT_CONTIG_SAMPLE {
        label = 'cpu_medium'
        container = params.container_bcftools
    }

    withName: MERGE_CONTIG_CHUNK {
        label = 'cpu_merge'
        container = params.container_bcftools
    }

    withName: MERGE_CONTIG_FINAL {
        label = 'cpu_merge'
        container = params.container_bcftools
    }

    withName: FLAGSTAT_CRAM {
        label = 'cpu_small'
        container = params.container_samtools
    }

    withName: PRECHECK_GPU_PROFILE_COUNTS {
        label = 'cpu_small'
        container = params.container_bcftools
    }

    // =========================
    // RESOURCES
    // =========================

    withLabel: cpu_small {
        cpus = params.cpu_small_cpus
        memory = params.cpu_small_memory
        time = params.cpu_small_time
    }

    withLabel: cpu_medium {
        cpus = params.cpu_medium_cpus
        memory = params.cpu_medium_memory
        time = params.cpu_medium_time
    }

    withLabel: cpu_merge {
        cpus = params.cpu_merge_cpus
        memory = params.cpu_merge_memory
        time = params.cpu_merge_time
    }

    withLabel: gpu_call {
        cpus = params.gpu_call_cpus
        memory = params.gpu_call_memory
        time = params.gpu_call_time
    }

    // GPU SLURM FIX (IMPORTANT)
    withLabel: gpu_call {
        clusterOptions = "--gres=gpu:${params.slurm_gpu_request}"
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/dag.html"
}

profiles {

    standard {
        process.executor = 'local'
    }

    slurm {
        process {
            executor = 'slurm'
            queue = params.slurm_cpu_queue
        }
    }

    singularity {

        singularity {
            enabled = true
            autoMounts = true
            cacheDir = params.singularity_cache_dir
            pullMode = 'never'
        }

        docker {
            enabled = false
        }
    }

    singularity_offline {

        process.executor = 'slurm'

        singularity {
            enabled = true
            autoMounts = true
            cacheDir = params.singularity_cache_dir
            runOptions = '--nv'
            pullMode = 'never'
        }

        docker {
            enabled = false
        }
    }

    apptainer {

        singularity {
            enabled = true
            autoMounts = true
            cacheDir = params.singularity_cache_dir
            runOptions = '--nv'
            pullMode = 'never'
        }

        docker {
            enabled = false
        }
    }

    docker {
        docker {
            enabled = true
        }
        singularity {
            enabled = false
        }
    }
}