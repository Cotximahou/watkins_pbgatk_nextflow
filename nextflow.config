manifest {
    name = 'watkins/pbgatk-nextflow'
    version = '0.1.0'
    description = 'Watkins Parabricks + bcftools workflow in Nextflow DSL2'
}

params {
    samplesheet = null
    ref = null
    outdir = 'results'
    contig_subset = ''
    merge_chunk_size = 250
    run_flagstat = false

    // Default to online registry images so Singularity can pull/cache automatically.
    container_parabricks = 'docker://nvcr.io/nvidia/clara/clara-parabricks:4.3.3-1'
    container_bcftools = 'docker://quay.io/biocontainers/bcftools:1.21--h8b25389_0'
    container_samtools = 'docker://quay.io/biocontainers/samtools:1.18--h50ea8bc_1'

    // Calling defaults
    call_htvc_threads = 32
    call_default_gpus = 1

    // Offline mode defaults (used by singularity_offline profile)
    local_container_dir = "${projectDir}/containers"

    // Slurm/cluster defaults (override via CLI or -params-file)
    slurm_cpu_queue = 'jic-compute,nbi-compute'
    slurm_gpu_queue = 'jic-gpu'
    slurm_gpu_type = 'a100'
    slurm_gpu_request = 1
    slurm_gpu_localscratch_gb = 1000
    slurm_merge_localscratch_gb = 1500

    cpu_small_cpus = 4
    cpu_small_memory = '16 GB'
    cpu_small_time = '2h'

    cpu_medium_cpus = 16
    cpu_medium_memory = '64 GB'
    cpu_medium_time = '8h'

    cpu_merge_cpus = 32
    cpu_merge_memory = '500 GB'
    cpu_merge_time = '24h'

    gpu_call_cpus = 32
    gpu_call_memory = '950 GB'
    gpu_call_time = '36h'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'

    withName: PBGATK_GERMLINE {
        label = 'gpu_call'
        container = params.container_parabricks
    }

    withName: COMPRESS_AND_INDEX_VCF {
        label = 'cpu_medium'
        container = params.container_bcftools
    }

    withName: GET_CONTIGS {
        label = 'cpu_small'
        container = params.container_bcftools
    }

    withName: EXTRACT_CONTIG_SAMPLE {
        label = 'cpu_medium'
        container = params.container_bcftools
    }

    withName: MERGE_CONTIG_CHUNK {
        label = 'cpu_merge'
        container = params.container_bcftools
    }

    withName: MERGE_CONTIG_FINAL {
        label = 'cpu_merge'
        container = params.container_bcftools
    }

    withName: FLAGSTAT_CRAM {
        label = 'cpu_small'
        container = params.container_samtools
    }

    withName: PRECHECK_GPU_PROFILE_COUNTS {
        label = 'cpu_small'
        container = params.container_bcftools
    }

    withLabel: cpu_small {
        cpus = params.cpu_small_cpus
        memory = params.cpu_small_memory
        time = params.cpu_small_time
    }

    withLabel: cpu_medium {
        cpus = params.cpu_medium_cpus
        memory = params.cpu_medium_memory
        time = params.cpu_medium_time
    }

    withLabel: cpu_merge {
        cpus = params.cpu_merge_cpus
        memory = params.cpu_merge_memory
        time = params.cpu_merge_time
    }

    withLabel: gpu_call {
        cpus = params.gpu_call_cpus
        memory = params.gpu_call_memory
        time = params.gpu_call_time
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/dag.html"
}

profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue = params.slurm_cpu_queue

        process.withLabel: cpu_merge {
            clusterOptions = "--gres=ssd --localscratch=ssd:${params.slurm_merge_localscratch_gb}"
        }
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${projectDir}/.singularity"
        docker.enabled = false
    }

    // Explicit online mode: pull/cached from registries via Singularity.
    singularity_online {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${projectDir}/.singularity"
        docker.enabled = false

        params.container_parabricks = 'docker://nvcr.io/nvidia/clara/clara-parabricks:4.3.3-1'
        params.container_bcftools = 'docker://quay.io/biocontainers/bcftools:1.21--h8b25389_0'
        params.container_samtools = 'docker://quay.io/biocontainers/samtools:1.18--h50ea8bc_1'
    }

    // Explicit offline mode: use local pre-staged SIF files.
    singularity_offline {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${projectDir}/.singularity"
        docker.enabled = false

        params.container_parabricks = "${params.local_container_dir}/parabricks-4.3.3-1.sif"
        params.container_bcftools = "${params.local_container_dir}/bcftools-1.21.sif"
        params.container_samtools = "${params.local_container_dir}/samtools-1.18.sif"
    }

    // Compatibility alias for users who still run -profile apptainer
    apptainer {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${projectDir}/.singularity"
        docker.enabled = false
    }

    docker {
        docker.enabled = true
        singularity.enabled = false

        params.container_parabricks = 'nvcr.io/nvidia/clara/clara-parabricks:4.3.3-1'
        params.container_bcftools = 'quay.io/biocontainers/bcftools:1.21--h8b25389_0'
        params.container_samtools = 'quay.io/biocontainers/samtools:1.18--h50ea8bc_1'
    }
}
